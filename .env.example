# 本番URL（必須）。未設定の場合は canonical / OG / sitemap を出力せず、robots で全ページ noindex になります。
# 本番: NEXT_PUBLIC_SITE_URL=https://www.shimizusekkotsuin.jp （Vercel の Production 環境変数に設定済み）
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 の測定ID（例: G-XXXXXXXXXX）。設定すると本番URL設定時のみ計測タグを出力します。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console の HTML タグ方式の所有権確認トークン（content="..." の値）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# コラム自動生成（GitHub Actions の Secrets に設定。ローカルで試す場合のみここに）
# ANTHROPIC_API_KEY=
# COLUMN_MODEL=claude-opus-5
